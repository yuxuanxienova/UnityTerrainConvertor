#usda 1.0

def Scope "Looks" {
    def Material "Antique_Rustic_Mantel_Clock" {
        token outputs:surface.connect = </Looks/Antique_Rustic_Mantel_Clock/PreviewSurface.outputs:surface>
        def Shader "Primvar_st" {
            uniform token info:implementationSource = "id"
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
        def Shader "UVTransform" {
            uniform token info:implementationSource = "id"
            uniform token info:id = "UsdTransform2d"
            float2 inputs:in.connect = </Looks/Antique_Rustic_Mantel_Clock/Primvar_st.outputs:result>
            float inputs:rotation = 0
            float2 inputs:scale = (1, 1)
            float2 inputs:translation = (0, 0)
            float2 outputs:result
        }
        def Shader "AlbedoTex" {
            uniform token info:implementationSource = "id"
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @assets/Antique Square Mantel Clock Type C Wood02_AlbedoTransparency.jpg@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Looks/Antique_Rustic_Mantel_Clock/UVTransform.outputs:result>
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 inputs:scale = (1, 1, 1)
            float3 outputs:rgb
            float outputs:a
        }
        def Shader "NormalTex" {
            uniform token info:implementationSource = "id"
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @assets/Antique Square Mantel Clock Type C Wood02_Normal.jpg@
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Looks/Antique_Rustic_Mantel_Clock/UVTransform.outputs:result>
            float3 inputs:scale = (2, 2, 2)
            float3 inputs:bias = (-1, -1, -1)
            token inputs:wrapS = "repeat"
            token inputs:wrapT = "repeat"
            float3 outputs:rgb
        }
        def Shader "PreviewSurface" {
            uniform token info:implementationSource = "id"
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Looks/Antique_Rustic_Mantel_Clock/AlbedoTex.outputs:rgb>
            normal3f inputs:normal.connect = </Looks/Antique_Rustic_Mantel_Clock/NormalTex.outputs:rgb>
            float inputs:roughness = 0.5
            float inputs:opacity = 1
            float inputs:specular = 0.5
            float inputs:ior = 1.5
            float inputs:metallic = 0
            token outputs:surface
        }
    }
}
